# Dependencies — never commit node_modules. package-lock.json IS committed
# (needed for reproducible `npm ci`), only the installed packages are ignored.
node_modules/

# Environment / secrets — never commit real credentials.
.env
.env.local
.env.*.local

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Vercel local artifacts
.vercel
