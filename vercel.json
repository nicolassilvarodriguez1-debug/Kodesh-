{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/study",        "destination": "https://kodesh-study.vercel.app/study" },
    { "source": "/study/:path*", "destination": "https://kodesh-study.vercel.app/study/:path*" },
    { "source": "/app",          "destination": "/index.html" }
  ],
  "functions": {
    "api/search.js":    { "memory": 256, "maxDuration": 30 },
    "api/assistant.js": { "memory": 256, "maxDuration": 30 },
    "api/usage.js":     { "memory": 128, "maxDuration": 10 },
    "api/checkout.js":  { "memory": 128, "maxDuration": 15 },
    "api/webhook.js":   { "memory": 128, "maxDuration": 30 },
    "api/confirm.js":   { "memory": 128, "maxDuration": 15 },
    "api/sync-premium.js": { "memory": 128, "maxDuration": 15 },
    "api/lexicon.js":   { "memory": 512, "maxDuration": 10 },
    "api/admin.js":     { "memory": 256, "maxDuration": 30 },
    "api/textual.js":   { "memory": 512, "maxDuration": 30 },
    "api/app-version.js": { "memory": 128, "maxDuration": 10 },
    "api/portal.js":    { "memory": 128, "maxDuration": 15 },
    "api/cron-daily-reminder.js": { "memory": 256, "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron-daily-reminder?type=promise", "schedule": "0 12 * * *" },
    { "path": "/api/cron-daily-reminder?type=reading", "schedule": "0 21 * * *" },
    { "path": "/api/cron-daily-reminder?type=night", "schedule": "0 1 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
